        "slots": {
          "children": {
            "hints": 64,
            "slots": {
              "children": {
                "hints": 96,
                "slots": {
                  "children": {
                    "hints": 96,
                    "slots": {
                      "children": {
                        "hints": 160,
                        "slots": null
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
