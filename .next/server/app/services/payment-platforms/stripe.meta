    "x-next-cache-tags": "_N_T_/layout,_N_T_/(site)/layout,_N_T_/(site)/services/layout,_N_T_/(site)/services/payment-platforms/layout,_N_T_/(site)/services/payment-platforms/[platform]/layout,_N_T_/(site)/services/payment-platforms/[platform]/page,_N_T_/services/payment-platforms/stripe"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/_index",
    "/!KHNpdGUp",
    "/!KHNpdGUp/services/payment-platforms/$d$platform/__PAGE__"
  ],
