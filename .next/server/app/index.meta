{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/(site)/layout,_N_T_/(site)/page,_N_T_/,_N_T_/index"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/_index",
    "/!KHNpdGUp",
    "/!KHNpdGUp/__PAGE__"
  ],
  "prefetchHints": {
    "hints": 0,
    "slots": {
      "children": {
        "hints": 0,
        "slots": {
          "children": {
            "hints": 128,
            "slots": null
          }
        }
      }
    }
  }
}